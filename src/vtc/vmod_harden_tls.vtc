varnishtest "vmod-harden: TLS SNI and certificate matching"

feature tls_1_3

shell {
cat >vtls.cfg <<EOF
  frontend = {
      host = "*"
      port = "0"
  }

  pem-file = "${testdir}/../etc/example.com.pem"
  tls-protos = TLSv1.3
EOF
}

server s1 {
	rxreq
	txresp
} -start

# TLS frontend with harden VMOD. Cert: example.com, www.example.com, 1.2.3.4.
varnish v1 \
	-arg "-A ${tmpdir}/vtls.cfg" \
	-vcl+backend {
	import harden;

	sub vcl_deliver {
	}
} -start

# SNI matches cert -> handshake succeeds.
client c1 {
	tls_config {
		version = TLSv1.3
		ciphersuites = "TLS_AES_128_GCM_SHA256"
		servername = "example.com"
	}
	tls_handshake
	txreq
	rxresp
	expect resp.status == 200
	expect tls.failed != "true"
} -run

# SNI does not match -> handshake aborted.
client c2 {
	tls_config {
		version = TLSv1.3
		ciphersuites = "TLS_AES_128_GCM_SHA256"
		servername = "nomatch.invalid"
	}
	tls_handshake
	expect tls.failed == "true"
} -run

# IP in SNI matches cert SAN -> handshake succeeds.
client c3 {
	tls_config {
		version = TLSv1.3
		ciphersuites = "TLS_AES_128_GCM_SHA256"
		servername = "1.2.3.4"
	}
	tls_handshake
	txreq
	rxresp
	expect resp.status == 200
	expect tls.failed != "true"
} -run

# No SNI -> handshake aborted.
client c4 {
	tls_config {
		version = TLSv1.3
		ciphersuites = "TLS_AES_128_GCM_SHA256"
	}
	tls_handshake
	expect tls.failed == "true"
} -run
